{
  "name": "envision",
  "version": "2.0.0",
  "description": "Envision AR Playground: manual placement, shared scene editing and local composition saving",
  "main": "index.js",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "npm run build:ar && vite --config website/vite.config.mts",
    "start": "npm run dev",
    "dev:ar": "webpack serve --mode development",
    "build:ar": "webpack --mode production",
    "build:website": "vite build --config website/vite.config.mts",
    "build": "npm run typecheck && npm run build:website && npm run build:ar && node scripts/finalize-build.mjs",
    "preview": "vite preview --config website/vite.config.mts --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p website/tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "measure:performance": "node scripts/measure-performance.mjs"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "@fontsource/inter": "^5.2.0",
    "@react-three/fiber": "^8.18.0",
    "html-webpack-plugin": "^5.3.1",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.152.0",
    "webpack": "^5.36.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.56.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.152.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "css-loader": "^5.2.6",
    "fake-indexeddb": "^6.2.7",
    "postcss": "^8.5.6",
    "style-loader": "^2.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^6.1.0"
  }
}
